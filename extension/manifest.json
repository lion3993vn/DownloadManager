{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["downloads", "cookies", "contextMenus", "storage", "webRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["common.js", "media.js", "background.js"]
  },
  "action": {
    "default_title": "DownloadManager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon32.png",
      "32": "icons/icon32.png",
      "48": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*", "https://douyin.com/*"],
      "js": ["douyin-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon32.png",
    "32": "icons/icon32.png",
    "48": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "connector@downloadmanager.local",
      "strict_min_version": "128.0"
    }
  }
}
