{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DownloadManager",
  "version": "0.2.0",
  "identifier": "com.downloadmanager.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DownloadManager",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DownloadManager",
    "category": "Utility",
    "shortDescription": "Trình tải xuống đa luồng",
    "longDescription": "Tải tệp nhanh hơn bằng nhiều kết nối song song, tạm dừng/tiếp tục, và tự bắt lượt tải từ trình duyệt.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../extension/": "extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "DownloadManager"
      }
    }
  }
}
